{
  "name": "madtv-app",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Mad TV — Der Sendermanager. Eigenständige Nachbildung des Rainbow-Arts-Klassikers von 1991.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "build:vollbild": "tsc --noEmit && vite build --mode vollbild",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vitest run tests/balance.test.ts --reporter=verbose",
    "sim:breit": "MADTV_BREIT=1 vitest run tests/breit.test.ts --reporter=verbose",
    "test:ui": "node tests/browser/ui.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^3.2.4"
  }
}
